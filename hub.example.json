{
 "server": "unix:///path/to/rex/server.sock",
 "state": "/path/to/.lazyrex/state",
 "view": "/path/to/.lazyrex/bin/lazyrex-view",
 "agents": [
  {
   "id": "user",
   "name": "User",
   "status_record": ""
  }
 ],
 "plugins": [
  {
   "name": "lazyrex",
   "path": "/path/to/LazyRex/plugins/lazyrex.lua"
  },
  {
   "name": "messaging",
   "path": "/path/to/Messaging/messaging.lua"
  },
  {
   "name": "profiles",
   "path": "/path/to/Profiles/profiles.lua"
  },
  {
   "name": "templates",
   "path": "/path/to/Templates/templates.lua",
   "events": "all"
  },
  {
   "name": "tunnels",
   "path": "/path/to/Tunnels/tunnels.lua",
   "events": "all"
  },
  {
   "name": "worktrees",
   "path": "/path/to/Worktrees/worktrees.lua",
   "events": "all"
  }
 ],
 "profiles": "/path/to/.lazyrex/profiles.json",
 "palette_lua": "/path/to/.config/rex/lazyrex_palette.lua",
 "transcript": true
}
