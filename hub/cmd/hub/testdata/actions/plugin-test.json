  "name": "hub.peer.plugins",
  "title": "hub.peer.plugins"
 },
 {
  "args": {
   "additionalProperties": false,
   "properties": {},
   "type": "object"
  },
  "description": "List this hub's name and its peer hubs: for each, its server, the link state (up, down or unknown), the last success and error, the envelopes from this hub that it has not acked (outbox, oldest_age_s), the cursor of what this hub took from it (after), the identity of its outbox that the cursor belongs to (outbox_id; a new one resets the cursor), whether it holds more, and the envelopes from it that no plugin here could take since the hub started (dropped). A remote agent's address is \"\u003cagent\u003e@\u003chub\u003e\".",
  "kind": "client",
  "name": "hub.peer.status",
  "title": "Peer hubs"
 },
 {
  "args": {
   "additionalProperties": false,
   "properties": {
    "render": {
     "description": "The render ID of view.render. The SDK sends it in a render.",
     "type": "string"
    }
   },
   "type": "object"
  },
  "description": "List the named commands (profiles) that can start in a new tab, with their kind (agent or accessory), their default cwd (empty: the home directory) and how many run now. args lists the named values that hub.spawn accepts for the profile (name, label, default, required).",
  "kind": "client",
  "name": "hub.profiles",
  "title": "List profiles"
 },
 {
  "args": {
   "additionalProperties": false,
   "properties": {
    "args": {
     "additionalProperties": {
      "maxLength": 16000,
      "type": "string"
     },
     "description": "Named values for the profile, for example {\"task\": \"Fix the login test\"}. hub.profiles lists each profile's args.",
     "type": "object"
    },
    "cwd": {
     "description": "An existing absolute directory to start in, for example a worktree from worktree_create. Replaces the profile's cwd.",
     "minLength": 1,
     "type": "string"
    },
    "for": {
     "type": "string"
    },
    "key": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "on_behalf": {
     "type": "integer"
    },
    "placement": {
     "additionalProperties": false,
     "description": "Default: a new tab in the work session. Choose another session, split beside a placed block, or start detached.",
     "properties": {
      "beside": {
       "description": "A placed block ID in the target session.",
       "minLength": 1,
       "type": "string"
      },
      "detached": {
       "description": "Start without a tab. Cannot be combined with beside.",
       "type": "boolean"
      },
      "direction": {
       "description": "Requires beside. Default: right.",
       "enum": [
        "right",
        "left",
        "above",
        "below"
       ],
       "type": "string"
      },
      "focus": {
       "additionalProperties": false,
       "description": "User spawns only. Focus on the first successful open, only while this source tab is still active in the target session. Never focus after an unknown outcome or on retry.",
       "properties": {
        "source_window_id": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "source_window_id"
       ],
       "type": "object"
      },
      "ratio": {
       "description": "Requires beside. Fraction for the new pane. Default: 0.5.",
       "exclusiveMaximum": 1,
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "session": {
       "description": "Target session ID.",
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    },
    "profile": {
     "minLength": 1,
     "type": "string"
    },
    "title": {
     "maxLength": 60,
     "type": "string"
    }
   },
   "required": [
    "profile",
    "key"
   ],
   "type": "object"
  },
  "description": "Start a profile in a new tab, beside a block, or detached, in the chosen session. An agent profile gets its own agent ID, so it can message you. Choose a key; after an unknown outcome, retry with the same key. Returns spawn_id, session_id, status (open, pending, failed or closed) and agent_id.",
  "kind": "client",
  "name": "hub.spawn",
  "title": "Start a profile"
 },
 {
  "args": {
   "additionalProperties": false,
   "properties": {
    "render": {
     "description": "The render ID of view.render. The SDK sends it in a render.",
     "type": "string"
    },
    "spawn_id": {
     "minLength": 1,
     "type": "string"
    }
   },
   "type": "object"
  },
  "description": "List started profiles that are not closed: spawn_id, session_id, cwd, profile, title, parent, agent_id, state (starting, running, exited, failed), error and program status. An agent worker also has identity_seen (true once its pane has had a current conversation identity), and, when open, identity: current or none, with identity_id (the current identity's ID) when current. With spawn_id: only that worker; not_found when it is closed or unknown.",
  "kind": "client",
  "name": "hub.workers",
  "title": "List workers"
 },
 {
  "args": {
   "additionalProperties": false,
   "properties": {
    "for": {
     "type": "string"
    },
    "key": {
     "maxLength": 128,
     "type": "string"
    },
    "on_behalf": {
     "type": "integer"
    },
    "spawn_id": {
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "spawn_id"
   ],
   "type": "object"
  },
  "description": "Close a worker's tab, or dismiss a failed start. A pending start with an unknown outcome cannot be stopped. Any agent can stop any worker, also one that another agent or the user started. Safe to retry: stop is idempotent by spawn_id, and key is optional.",
  "kind": "client",
  "name": "hub.stop",
  "title": "Stop a worker"
 },
